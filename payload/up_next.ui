<ui>
  <!-- Songs after the current one in the Now Playing list; choosing a row removes it. -->
  <list id="CFW_UpNext" title="Up Next" action="CFW_UpNextRemove"/>
  <string id="CFW_UP_NEXT_LABEL" text="Up Next"/>
  <screen-event screen="NowPlaying_Screen" event="contextualMenu.CFW_UpNext" handler="CFW_UpNext"/>
</ui>
